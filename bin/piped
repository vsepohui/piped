#!/usr/bin/perl

use 5.022;
use warnings;

use AnyEvent;
use AnyEvent::Socket;
use AnyEvent::Handle;
use Crypter;

use Pod::Usage qw(pod2usage);

$| = 1;

usage() if scalar @ARGV != 5;
my ($password, $local, $port, $remote, $remoteport) = @ARGV;

my $cv = AE::cv;

my $crypter = new Crypter(password => $password);

my $hdl1;
my $hdl2;

sub crypt_data {
	my $data = shift;
	my $encrypted = '';
	$crypter->crypt(input => $data, output => \$encrypted);	
	
	return $encrypted;
}

my $server = tcp_server $local, $port, sub {
	my ($fh, $host, $port) = @_;
	warn "CLIENT $host CONNECTED TO SERVER";

	$hdl1 = AnyEvent::Handle->new (fh => $fh, on_eof => sub { warn "EOF SERVER"; $cv->broadcast },
		on_read => sub {
			my ($handle) = @_;
			my $data = $handle->rbuf;
			warn "GETTED FROM CLIENT $data";
			$data = crypt_data($data);
			$hdl2->push_write($data) if $hdl2;
		}	
	);
	

};

my $connnect = tcp_connect $remote, $remoteport, sub {
	my ($fh) = @_;
	warn "CONNECT TO REMOTE SERVER";


	$hdl2 = AnyEvent::Handle->new (
		fh => $fh, 
		on_eof => sub { warn "EOF CONNECTION"; $cv->broadcast },
		on_read => sub {
			my ($handle) = @_;
			my $data = $handle->rbuf;
			$data = crypt_data($data);
			warn "GETTED FROM SERVER $data";
			$hdl1->push_write($data) if $hdl1;
		}
	);
	
	

};



$cv->wait;

sub usage {
	my $file = @_ ? "$_[0]" : (caller)[1];
	open my $handle, '>', \my $output;
	pod2usage -exitval => 'noexit', -input => $file, -output => $handle;
	$output =~ s/^.*\n|\n$//;
	$output =~ s/\n$//g;
	say $output;
	exit;
}

1;

=encoding utf8

=head1 NAME

piped - secured tunnel for a jammers

=head1 SYNOPSIS

    Usage: piped [password] [local] [port] [remote] [remoreport]
    
    Options:
    
        password      Password for Crypter
        local         Bind address
        port          Bind port
        remote        Remote server
        remoteport    Remote port

