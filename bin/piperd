#!/usr/bin/perl

use 5.022;
use warnings;

use AnyEvent;
use AnyEvent::Socket;
use AnyEvent::Handle;
use Crypter;

use Pod::Usage qw(pod2usage);

$| = 1;

usage() if scalar @ARGV != 5;
my ($password, $local, $port, $remote, $remoteport) = @ARGV;

my $cv = AE::cv;

my $crypter = new Crypter(password => $password);

my $hdl1;
my $hdl2;

my $connnect = tcp_connect $remote, $remoteport, sub {
	my ($fh) = @_;
	$hdl2 = AnyEvent::Handle->new (fh => $fh, on_eof => sub {});
	$hdl2->push_read(sub {
		my ($hdl, $data) = @_;
		my $encrypted = '';
		$crypter->crypt(input => $data, output => \$encrypted);
		warn "PUSH TO LOCAL: $encrypted";
		$hdl1->push_write($encrypted) if $hdl1;
	});
};



my $server = tcp_server $local, $port, sub {
	my ($fh, $host, $port) = @_;
	$hdl1 = AnyEvent::Handle->new (fh => $fh, on_eof => sub {});
	
	$hdl1->push_read (sub {
		my ($hdl, $data) = @_;
		my $encrypted = '';
		$crypter->crypt(input => $data, output => \$encrypted);
		warn "PUSH TO REMOTE: $encrypted";
		$hdl2->push_write($encrypted) if $hdl2;
	});
};

$cv->recv;

sub usage {
	my $file = @_ ? "$_[0]" : (caller)[1];
	open my $handle, '>', \my $output;
	pod2usage -exitval => 'noexit', -input => $file, -output => $handle;
	$output =~ s/^.*\n|\n$//;
	$output =~ s/\n$//g;
	say $output;
	exit;
}

1;

=encoding utf8

=head1 NAME

piper - secured tunnel for a jammers

=head1 SYNOPSIS

    Usage: piper [password] [local] [port] [remote] [remoreport]
    
    Options:
    
        password      Password for Crypter
        local         Bind address
        port          Bind port
        remote        Remote server
        remoteport    Remote port

